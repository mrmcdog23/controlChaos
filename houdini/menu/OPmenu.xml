    <subMenu id="cc.hda">
      <label>HDA</label>

      <scriptItem id="cc.hda.make_local">
        <label>Make Definition Local</label>
        <context>
          <expression>
          node = kwargs.get("node", None)
          if node is None:
              return False
          if not node.type().definition():
              return False
          return True
          </expression>
        </context>
        <scriptCode><![CDATA[import cchoudini.utils.hou_utils as hu;hu.hda_make_local()]]>
        </scriptCode>
      </scriptItem>

